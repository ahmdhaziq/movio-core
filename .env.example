# Local development PostgreSQL. Keep DATABASE_URL in sync if these values change.
POSTGRES_USER=movio
POSTGRES_PASSWORD=movio_local
POSTGRES_DB=movio
POSTGRES_PORT=5432
DATABASE_URL="postgresql://movio:movio_local@127.0.0.1:5432/movio?schema=public"
# Optional: export TEST_DATABASE_URL when running tests against another database.
# Tests use isolated random schemas, not the application's public schema.
# TEST_DATABASE_URL="postgresql://movio:movio_local@127.0.0.1:5432/movio"

# Set independently generated base64 keys (at least 32 random bytes each).
# Generate each separately: openssl rand -base64 32
AUTH_ACCESS_SECRET=
AUTH_REFRESH_SECRET=
# HS256; issuer movio-core; access audience movio-api; refresh audience movio-refresh.
# Access lifetime: 3,600 seconds. Renewal deadline: 2,592,000 seconds from login.
